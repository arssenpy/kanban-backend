# Local: postgresql://postgres:PASSWORD@localhost:5433/kanban_db (see docker-compose.yml)
# Neon: copy the connection string from the Neon dashboard (it ends with ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"
# Optional: direct (non-pooled) connection for `prisma migrate`; defaults to DATABASE_URL
DIRECT_URL=""
JWT_SECRET="secret key"
JWT_EXPIRES_IN="7d"
PORT=5000
# Allowed CORS origins, comma-separated (localhost:3000 is always allowed)
FRONTEND_URL="https://kanban-mu-ten.vercel.app"
